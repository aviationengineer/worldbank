# Copy to .env and fill in. NEVER commit .env or credential files.
# Google Service Account (enterprise path)
GOOGLE_APPLICATION_CREDENTIALS=/secure/path/service-account.json
# Target spreadsheet ("World Bank Data Intelligence")
GOOGLE_SHEET_ID=your_sheet_id_here
# Local-dev connector transport (used when GOOGLE_APPLICATION_CREDENTIALS is unset)
GWS_CLI=/opt/hatch/bin/hatch_gws_cli
# Overrides
WB_BASE_URL=https://api.worldbank.org/v2
WB_LOG_LEVEL=INFO
